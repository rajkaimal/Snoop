    <ProjectReference Include="..\Snoop.Hosting\Snoop.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snoop.Cli.Tests" />
  </ItemGroup>

</Project>
