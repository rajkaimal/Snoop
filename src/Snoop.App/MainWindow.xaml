<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Snoop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:views="using:Snoop.App.Views"
    xmlns:helpers="using:Snoop.App.Helpers"
    xmlns:settings="using:Snoop.Presentation.Settings"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:controls="using:Snoop.App.Controls"
    Title="Snoop">

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnToolShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnToolShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnToolShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number4" Invoked="OnToolShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number5" Invoked="OnToolShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number6" Invoked="OnToolShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <DataTemplate x:Key="OverviewTemplate" x:DataType="vm:NameValueRow">
                <Grid ColumnSpacing="12" Padding="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ Title bar (content extends into it) -->
        <Grid x:Name="AppTitleBar" Height="34" Padding="16,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Snoop" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <!-- ============================================================ Toolbar -->
        <!-- One primary action (capture) and the search on the left; everything else is a quiet command. -->
        <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Padding="8,0,8,2">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,4,12,4">
                    <Button
                        Command="{x:Bind ViewModel.ToggleCaptureCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="128"
                        ToolTipService.ToolTip="Start or stop capturing this PC's traffic">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind helpers:UiHelpers.CaptureGlyph(ViewModel.IsCapturing), Mode=OneWay}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.CaptureButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Search URLs, headers and bodies (Ctrl+F)"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnSearchKeyDown"
                        ToolTipService.ToolTip="Enter selects the next match, Shift+Enter the previous one"
                        Width="300"
                        VerticalAlignment="Center" />
                    <!-- Shown while the list is limited to one host or app; click to show everything again. -->
                    <Button
                        Command="{x:Bind ViewModel.ClearScopeCommand}"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.HasScope), Mode=OneWay}"
                        VerticalAlignment="Center"
                        Padding="10,3"
                        CornerRadius="12"
                        ToolTipService.ToolTip="Showing only this host or app. Click to show everything.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.ScopeText, Mode=OneWay}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </CommandBar.Content>

            <AppBarButton Label="Filter" ToolTipService.ToolTip="What the list shows">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71C;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <ToggleMenuFlyoutItem Text="Hide tunnels" IsChecked="{x:Bind ViewModel.HideTunnels, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Hide images, CSS and fonts" IsChecked="{x:Bind ViewModel.HideStatic, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Errors only" IsChecked="{x:Bind ViewModel.OnlyErrors, Mode=TwoWay}" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem Text="{x:Bind ViewModel.OnlyHostMenuText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsOnlyHost, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="{x:Bind ViewModel.OnlyProcessMenuText, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsOnlyProcess, Mode=TwoWay}" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem Text="Search inside bodies" IsChecked="{x:Bind ViewModel.SearchBodies, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Scroll to new sessions" IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarButton Label="Saved" ToolTipService.ToolTip="Saved filters">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE728;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="8" Width="340">
                            <TextBlock Text="Save the current search and filters" Style="{StaticResource SectionLabel}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Name, e.g. chrome api errors" Text="{x:Bind ViewModel.NewFilterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Save" Command="{x:Bind ViewModel.SaveFilterCommand}" />
                            </Grid>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.SavedFilters}"
                                IsItemClickEnabled="True"
                                ItemClick="OnSavedFilterClick"
                                SelectionMode="None"
                                MaxHeight="260"
                                ItemContainerStyle="{StaticResource CompactListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="settings:SavedFilter">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind SearchText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind}" Click="OnDeleteSavedFilter" ToolTipService.ToolTip="Delete" Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarToggleButton
                Label="System proxy"
                IsChecked="{x:Bind ViewModel.IsSystemProxyOn, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.IsSystemProxySupported}"
                ToolTipService.ToolTip="Route this PC's traffic through Snoop. Put back automatically when Snoop stops.">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton Label="Decrypt HTTPS" IsChecked="{x:Bind ViewModel.DecryptHttps, Mode=TwoWay}" ToolTipService.ToolTip="Show the contents of HTTPS traffic">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE72E;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>

            <AppBarSeparator />

            <AppBarButton Label="Clear" Command="{x:Bind ViewModel.ClearCommand}" ToolTipService.ToolTip="Remove every session">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE894;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Settings" Command="{x:Bind ViewModel.OpenSettingsCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="New request in Composer" Command="{x:Bind ViewModel.NewComposerRequestCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE724;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Save snapshot... (Ctrl+S)" Command="{x:Bind ViewModel.SaveSnapshotCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Open snapshot or HAR... (Ctrl+O)" Command="{x:Bind ViewModel.LoadSnapshotCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Export as HAR..." Command="{x:Bind ViewModel.ExportHarCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEDE1;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Export as HAR, secrets redacted..." Command="{x:Bind ViewModel.ExportRedactedHarCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Export as text..." Command="{x:Bind ViewModel.ExportTextCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- ============================================================ Messages -->
        <StackPanel Grid.Row="2" Padding="12,0,12,4" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.ShowTrustPrompt, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="HTTPS needs the Snoop root certificate"
                Message="Until it is trusted, apps will show certificate errors for decrypted sites.">
                <InfoBar.ActionButton>
                    <Button Content="Trust certificate" Command="{x:Bind ViewModel.TrustRootCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Severity="{x:Bind helpers:UiHelpers.Severity(ViewModel.MessageIsError), Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                CloseButtonCommand="{x:Bind ViewModel.DismissMessageCommand}" />
        </StackPanel>

        <!-- ============================================================ Sessions | Inspector -->
        <Grid x:Name="SplitArea" Grid.Row="3" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="3*" MinWidth="440" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="DetailColumn" Width="2*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- Session grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="20,2,8,2" Margin="8,0,0,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem Text="Type" IsChecked="{x:Bind ViewModel.Sessions.Columns.TypeVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Result" IsChecked="{x:Bind ViewModel.Sessions.Columns.ResultVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Method" IsChecked="{x:Bind ViewModel.Sessions.Columns.MethodVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Protocol" IsChecked="{x:Bind ViewModel.Sessions.Columns.ProtocolVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Host" IsChecked="{x:Bind ViewModel.Sessions.Columns.HostVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Size" IsChecked="{x:Bind ViewModel.Sessions.Columns.SizeVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Time" IsChecked="{x:Bind ViewModel.Sessions.Columns.TimeVisible, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Process" IsChecked="{x:Bind ViewModel.Sessions.Columns.ProcessVisible, Mode=TwoWay}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Reset columns" Command="{x:Bind ViewModel.ResetColumnsCommand}" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.IdWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.TypeWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.ResultWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.MethodWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.ProtocolWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.HostWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="*" MinWidth="120" /> <!-- Path: never squeezed to nothing; columns to its right clip first -->
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.SizeWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.TimeWidth), Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(ViewModel.Sessions.Columns.ProcessWidth), Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Button Tag="Id" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.IdHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Right" Background="Transparent"><primitives:Thumb Tag="Id" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Button Tag="Type" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.TypeHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Right" Background="Transparent"><primitives:Thumb Tag="Type" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Button Tag="Result" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.ResultHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Right" Background="Transparent"><primitives:Thumb Tag="Result" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="3">
                        <Button Tag="Method" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.MethodHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Right" Background="Transparent"><primitives:Thumb Tag="Method" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="4">
                        <Button Tag="Protocol" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.ProtocolHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Right" Background="Transparent"><primitives:Thumb Tag="Protocol" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="5">
                        <Button Tag="Host" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.HostHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Right" Background="Transparent"><primitives:Thumb Tag="Host" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="6">
                        <Button Tag="Path" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.PathHeader, Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Column="7">
                        <Button Tag="Size" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.SizeHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Left" Background="Transparent"><primitives:Thumb Tag="Size" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="8">
                        <Button Tag="Time" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.TimeHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Left" Background="Transparent"><primitives:Thumb Tag="Time" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                    <Grid Grid.Column="9">
                        <Button Tag="Process" Click="OnHeaderClick" Style="{StaticResource HeaderButton}" Content="{x:Bind ViewModel.Sessions.Columns.ProcessHeader, Mode=OneWay}" />
                        <controls:ResizeCursorArea HorizontalAlignment="Left" Background="Transparent"><primitives:Thumb Tag="Process" DragDelta="OnColumnResize" DragCompleted="OnColumnResizeCompleted" Style="{StaticResource ColumnGrip}" /></controls:ResizeCursorArea>
                    </Grid>
                </Grid>

                <!-- Empty state: what to do next, instead of a blank list. -->
                <StackPanel
                    Grid.Row="1"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsGridEmpty), Mode=OneWay}">
                    <FontIcon Glyph="&#xE774;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyGridTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyGridText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ListView
                    x:Name="SessionList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Sessions.Rows, Mode=OneWay}"
                    SelectionMode="Extended"
                    SelectionChanged="OnSessionSelectionChanged"
                    ContextRequested="OnSessionContextRequested"
                    KeyDown="OnSessionListKeyDown"
                    DoubleTapped="OnSessionDoubleTapped"
                    Margin="8,0,0,0"
                    ItemContainerStyle="{StaticResource CompactListItemStyle}">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy URL" Command="{x:Bind ViewModel.CopyUrlCommand}" />
                            <MenuFlyoutItem Text="Copy as cURL" Command="{x:Bind ViewModel.CopyCurlCommand}" />
                            <MenuFlyoutItem Text="Copy as PowerShell" Command="{x:Bind ViewModel.CopyPowerShellCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Edit in Composer" Command="{x:Bind ViewModel.EditInComposerCommand}" />
                            <MenuFlyoutItem Text="Auto-respond with this response (new rule)" Command="{x:Bind ViewModel.CreateRuleCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Mark for compare" Command="{x:Bind ViewModel.MarkForCompareCommand}" />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.MarkedForCompareText, Mode=OneWay}" Command="{x:Bind ViewModel.CompareWithMarkedCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Show only this host" Command="{x:Bind ViewModel.ShowOnlyHostCommand}" />
                            <MenuFlyoutItem Text="Show only this app" Command="{x:Bind ViewModel.ShowOnlyProcessCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Export selected">
                                <MenuFlyoutItem Text="As HAR..." Command="{x:Bind ViewModel.ExportSelectedHarCommand}" />
                                <MenuFlyoutItem Text="As text..." Command="{x:Bind ViewModel.ExportSelectedTextCommand}" />
                                <MenuFlyoutItem Text="As snapshot..." Command="{x:Bind ViewModel.SaveSelectedSnapshotCommand}" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Don't decrypt this host" Command="{x:Bind ViewModel.SkipHostCommand}" />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.RemoveText, Mode=OneWay}" Command="{x:Bind ViewModel.RemoveSelectedCommand}" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRowViewModel">
                            <Grid
                                Background="Transparent"
                                CanDrag="True"
                                DragStarting="OnRowDragStarting"
                                DropCompleted="OnRowDropCompleted"
                                Opacity="{x:Bind helpers:UiHelpers.RowOpacity(Category), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.IdWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.TypeWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.ResultWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.MethodWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.ProtocolWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.HostWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.SizeWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.TimeWidth), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind helpers:UiHelpers.Px(Columns.ProcessWidth), Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind IdText}" Style="{StaticResource CellText}" Margin="0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind MarkGlyphs, Mode=OneWay}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind TypeBadge, Mode=OneWay}" Style="{StaticResource CellText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Result, Mode=OneWay}" Style="{StaticResource CellText}" Foreground="{x:Bind helpers:UiHelpers.CategoryBrush(Category), Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Method, Mode=OneWay}" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Protocol, Mode=OneWay}" Style="{StaticResource CellText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Host, Mode=OneWay}" Style="{StaticResource CellText}" helpers:SearchHighlight.Query="{x:Bind Columns.HighlightText, Mode=OneWay}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Path, Mode=OneWay}" Style="{StaticResource CellText}" helpers:SearchHighlight.Query="{x:Bind Columns.HighlightText, Mode=OneWay}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Size, Mode=OneWay}" Style="{StaticResource CellText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="8" Text="{x:Bind Duration, Mode=OneWay}" Style="{StaticResource CellText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="9" Text="{x:Bind Process, Mode=OneWay}" Style="{StaticResource CellText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" helpers:SearchHighlight.Query="{x:Bind Columns.HighlightText, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Drag to give the list or the details more room. -->
            <controls:ResizeCursorArea Grid.Column="1" Background="Transparent">
                <primitives:Thumb Width="6" Style="{StaticResource ColumnGrip}" DragDelta="OnSplitterDrag" DragCompleted="OnSplitterDragCompleted" ToolTipService.ToolTip="Drag to resize" />
            </controls:ResizeCursorArea>

            <!-- ============================================================ Details card -->
            <!-- A tool rail on the left of the card; the selected tool fills the rest. Drop a session here to open it in the Composer. -->
            <Grid
                Grid.Column="2"
                Margin="0,0,12,8"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                AllowDrop="True"
                DragOver="OnInspectorDragOver"
                Drop="OnInspectorDrop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tool rail: icons with tooltips (Ctrl+1 to Ctrl+6); counts as badges. -->
                <Border BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ListView
                        x:Name="ToolRail"
                        SelectionMode="Single"
                        SelectionChanged="OnToolRailSelectionChanged"
                        SelectedIndex="{x:Bind ViewModel.SelectedToolIndex, Mode=TwoWay}"
                        Padding="0,6"
                        ItemContainerStyle="{StaticResource RailItemStyle}">
                        <ListViewItem ToolTipService.ToolTip="Inspect the selected session (Ctrl+1)" AutomationProperties.Name="Inspect">
                            <FontIcon Glyph="&#xE7B3;" FontSize="16" />
                        </ListViewItem>
                        <ListViewItem ToolTipService.ToolTip="Composer: write and send a request (Ctrl+2)" AutomationProperties.Name="Composer">
                            <FontIcon Glyph="&#xE724;" FontSize="16" />
                        </ListViewItem>
                        <ListViewItem ToolTipService.ToolTip="Rules: mock, delay, block or change matching traffic (Ctrl+3)" AutomationProperties.Name="Rules">
                            <Grid>
                                <FontIcon Glyph="&#xE9D5;" FontSize="16" />
                                <InfoBadge
                                    Value="{x:Bind ViewModel.RulesBadge, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhenPositive(ViewModel.RulesBadge), Mode=OneWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-12,0" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem ToolTipService.ToolTip="Breakpoints: pause and edit traffic (Ctrl+4)" AutomationProperties.Name="Breakpoints">
                            <Grid>
                                <FontIcon Glyph="&#xE769;" FontSize="16" />
                                <InfoBadge
                                    Value="{x:Bind ViewModel.BreakpointsBadge, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhenPositive(ViewModel.BreakpointsBadge), Mode=OneWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-12,0" />
                            </Grid>
                        </ListViewItem>
                        <ListViewItem ToolTipService.ToolTip="Timeline: when each request ran (Ctrl+5)" AutomationProperties.Name="Timeline">
                            <FontIcon Glyph="&#xE916;" FontSize="16" />
                        </ListViewItem>
                        <ListViewItem ToolTipService.ToolTip="Compare two sessions (Ctrl+6)" AutomationProperties.Name="Compare">
                            <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                        </ListViewItem>
                    </ListView>
                </Border>

                <Grid Grid.Column="1" Padding="14,10,14,8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Heading: the tool's name, or the selected session for Inspect. -->
                    <TextBlock
                        Text="{x:Bind ViewModel.CardTitle, Mode=OneWay}"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsToolMode), Mode=OneWay}"
                        Style="{StaticResource CardTitle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Inspector.Title, Mode=OneWay}"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsInspectorTab), Mode=OneWay}"
                        Style="{StaticResource CardTitle}"
                        IsTextSelectionEnabled="True" />

                    <!-- Inspect has three short views; they always fit. -->
                    <SelectorBar
                        x:Name="InspectTabs"
                        Grid.Row="1"
                        Margin="-12,0,0,0"
                        SelectionChanged="OnInspectTabChanged"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsInspectorTab), Mode=OneWay}">
                        <SelectorBarItem Text="Request &amp; Response" IsSelected="True" />
                        <SelectorBarItem Text="Overview" />
                        <SelectorBarItem Text="WebSocket" Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsWebSocketSelected), Mode=OneWay}" />
                    </SelectorBar>

                    <Grid Grid.Row="2">
                        <Grid RowSpacing="4" Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowInspectTab), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="REQUEST" Style="{StaticResource CaptionLabel}" />
                            <views:MessageView Grid.Row="1" Message="{x:Bind ViewModel.Inspector.Request}" ShowParameters="True" HighlightText="{x:Bind ViewModel.SearchText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Text="RESPONSE" Style="{StaticResource CaptionLabel}" Margin="0,8,0,0" />
                            <views:MessageView Grid.Row="3" Message="{x:Bind ViewModel.Inspector.Response}" ShowParameters="False" HighlightText="{x:Bind ViewModel.SearchText, Mode=OneWay}" />
                        </Grid>
                        <ListView
                            Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowOverviewTab), Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Inspector.Overview, Mode=OneWay}"
                            ItemTemplate="{StaticResource OverviewTemplate}"
                            ItemContainerStyle="{StaticResource CompactListItemStyle}"
                            SelectionMode="None" />
                        <views:WebSocketView Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowWebSocketTab), Mode=OneWay}" ViewModel="{x:Bind ViewModel.WebSocket}" />
                        <views:ComposerView Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowComposerTab), Mode=OneWay}" ViewModel="{x:Bind ViewModel.Composer}" />
                        <views:RulesView Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowRulesTab), Mode=OneWay}" ViewModel="{x:Bind ViewModel.Rules}" />
                        <views:BreakpointsView Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowBreakpointsTab), Mode=OneWay}" ViewModel="{x:Bind ViewModel.Breakpoints}" />
                        <views:TimelineView Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowTimelineTab), Mode=OneWay}" ViewModel="{x:Bind ViewModel}" />
                        <views:CompareView Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.ShowCompareTab), Mode=OneWay}" ViewModel="{x:Bind ViewModel.Compare}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Drag image for a session: a compact pill (method + host and path), drawn out of sight and snapshotted when a drag starts. -->
        <Canvas Grid.RowSpan="5" IsHitTestVisible="False" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border
                x:Name="DragToken"
                Canvas.Left="-4000"
                Canvas.Top="0"
                Padding="10,5,12,5"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="DragTokenMethod" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DragTokenText" FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ============================================================ Status bar -->
        <Grid Grid.Row="4" Padding="16,4,16,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind helpers:UiHelpers.CaptureBrush(ViewModel.IsCapturing), Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
