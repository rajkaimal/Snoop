<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snoop.App.Views.ComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Snoop.App.Views"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:helpers="using:Snoop.App.Helpers">

    <Grid RowSpacing="8" Padding="0,8,0,0" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <!-- While the Composer has focus, Ctrl+S saves the request (not a snapshot). -->
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ Title bar: library, name, environment, save -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                IsChecked="{x:Bind ViewModel.IsLibraryOpen, Mode=TwoWay}"
                Padding="8,5"
                ToolTipService.ToolTip="Show or hide saved requests">
                <FontIcon Glyph="&#xE8A0;" FontSize="14" />
            </ToggleButton>

            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <ComboBox
                Grid.Column="2"
                ItemsSource="{x:Bind ViewModel.Environments.Choices, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.Environments.SelectedIndex, Mode=TwoWay}"
                MinWidth="150"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Environment: where {{variables}} get their values" />

            <Button Grid.Column="3" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" ToolTipService.ToolTip="Save this request (Ctrl+S)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="13" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Padding="8,5" ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="New request" Click="OnNewRequest">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Save as..." Click="OnSaveAs" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Import cURL..." Click="OnImportCurl">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy as cURL" Command="{x:Bind ViewModel.CopyAsCurlCommand, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Variables and environments..." Click="OnEditVariables">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ============================================================ Request line -->
        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Text="{x:Bind ViewModel.Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="GET"
                FontFamily="{StaticResource MonoFont}"
                ToolTipService.ToolTip="Method: GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS..." />
            <TextBox
                Grid.Column="1"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="ComposerUrl"
                AutomationProperties.Name="URL"
                PlaceholderText="https://example.com/api, {{baseUrl}}/users, or paste a cURL command"
                FontFamily="{StaticResource MonoFont}"
                IsSpellCheckEnabled="False"
                ToolTipService.ToolTip="Paste a cURL command here to fill in the whole request" />
            <Button
                Grid.Column="2"
                Content="Send"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
                MinWidth="72"
                ToolTipService.ToolTip="Send (Ctrl+Enter)" />
            <Button
                Grid.Column="3"
                Content="Cancel"
                Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}" />
        </Grid>

        <!-- ============================================================ Library + editor -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Saved requests -->
            <Grid
                Width="210"
                RowSpacing="4"
                Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsLibraryOpen), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Saved requests" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <Button
                        HorizontalAlignment="Right"
                        Padding="6,3"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnNewFolder"
                        ToolTipService.ToolTip="New folder">
                        <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                    </Button>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Text="Nothing saved yet. Press Save to keep this request; it appears here."
                    TextWrapping="Wrap"
                    FontSize="12"
                    Margin="0,6,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.Library.IsEmpty), Mode=OneWay}" />

                <TreeView
                    x:Name="LibraryTree"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Library.Items, Mode=OneWay}"
                    SelectionMode="Single"
                    ItemInvoked="OnLibraryItemInvoked"
                    CanDragItems="False"
                    CanReorderItems="False"
                    AllowDrop="False">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryItemViewModel">
                            <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Name}">
                                <TreeViewItem.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Rename..." Tag="{x:Bind}" Click="OnRenameItem" />
                                        <MenuFlyoutItem Text="Duplicate" Tag="{x:Bind}" Click="OnDuplicateItem" Visibility="{x:Bind helpers:UiHelpers.VisibleWhenNot(IsFolder)}" />
                                        <MenuFlyoutItem Text="New folder here..." Tag="{x:Bind}" Click="OnNewFolderHere" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete..." Tag="{x:Bind}" Click="OnDeleteItem" />
                                    </MenuFlyout>
                                </TreeViewItem.ContextFlyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Editor and response -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Headers: a table with on/off ticks, or text -->
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.HeadersTitle, Mode=OneWay}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button
                            Command="{x:Bind ViewModel.AddHeaderCommand, Mode=OneWay}"
                            Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsTableEdit), Mode=OneWay}"
                            Padding="8,2"
                            FontSize="12"
                            ToolTipService.ToolTip="Add a header">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE710;" FontSize="10" />
                                <TextBlock Text="Add" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            IsChecked="{x:Bind ViewModel.IsBulkEdit, Mode=TwoWay}"
                            Content="Edit as text"
                            Padding="8,2"
                            FontSize="12"
                            ToolTipService.ToolTip="One Name: value per line; start a line with # to turn that header off" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="150"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsTableEdit), Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Headers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeaderRowViewModel">
                                <Grid ColumnSpacing="6" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Send this header" />
                                    <TextBox
                                        Grid.Column="1"
                                        Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Name"
                                        FontFamily="{StaticResource MonoFont}"
                                        FontSize="12"
                                        IsSpellCheckEnabled="False" />
                                    <TextBox
                                        Grid.Column="2"
                                        Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Value"
                                        FontFamily="{StaticResource MonoFont}"
                                        FontSize="12"
                                        IsSpellCheckEnabled="False" />
                                    <Button
                                        Grid.Column="3"
                                        Tag="{x:Bind}"
                                        Click="OnRemoveHeader"
                                        Padding="6,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBox
                    Grid.Row="1"
                    Style="{StaticResource CodeEditor}"
                    Text="{x:Bind ViewModel.HeadersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Accept: application/json&#x0a;# X-Debug: 1   (a # turns a header off)"
                    Height="130"
                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.IsBulkEdit), Mode=OneWay}" />

                <TextBlock Grid.Row="2" Text="Body" Style="{StaticResource SectionLabel}" />
                <TextBox
                    Grid.Row="3"
                    Style="{StaticResource CodeEditor}"
                    Text="{x:Bind ViewModel.BodyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Optional. JSON bodies get Content-Type: application/json unless you set one. {{variables}} work here too."
                    Height="120" />

                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSending, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                        AutomationProperties.AutomationId="ComposerResult"
                        Foreground="{x:Bind helpers:UiHelpers.MessageBrush(ViewModel.ResultIsError), Mode=OneWay}"
                        TextWrapping="Wrap"
                        FontSize="12"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True" />
                </StackPanel>

                <views:MessageView Grid.Row="5" Message="{x:Bind ViewModel.Response, Mode=OneWay}" ShowParameters="False" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
