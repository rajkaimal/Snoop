<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snoop.App.Views.CompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:helpers="using:Snoop.App.Helpers">

    <UserControl.Resources>
        <DataTemplate x:Key="LineTemplate" x:DataType="vm:CompareLine">
            <Grid Background="{x:Bind helpers:UiHelpers.DiffBrush(Kind)}" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind LeftNumber}" FontSize="11" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind RightNumber}" FontSize="11" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Marker}" FontSize="12" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="{x:Bind Text}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>

        <Style x:Key="DiffLineStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="6" Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="Only differences" IsChecked="{x:Bind ViewModel.OnlyDifferences, Mode=TwoWay}" MinWidth="0" />
        </Grid>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
            ItemTemplate="{StaticResource LineTemplate}"
            ItemContainerStyle="{StaticResource DiffLineStyle}"
            SelectionMode="None"
            BorderThickness="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Grid>
</UserControl>
