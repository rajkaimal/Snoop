<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snoop.App.Views.MessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:helpers="using:Snoop.App.Helpers">

    <UserControl.Resources>
        <DataTemplate x:Key="NameValueTemplate" x:DataType="vm:NameValueRow">
            <Grid ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Shown when there is no message (nothing selected, or no response yet). -->
        <TextBlock
            Text="{x:Bind Message.Placeholder, Mode=OneWay}"
            Visibility="{x:Bind helpers:UiHelpers.VisibleWhenNot(Message.IsPresent), Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Margin="12" />

        <Grid RowSpacing="2" Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(Message.IsPresent), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="HeadersTab" Text="{x:Bind Message.HeadersTitle, Mode=OneWay}" IsSelected="True" />
                <SelectorBarItem x:Name="ParamsTab" Text="{x:Bind Message.ParametersTitle, Mode=OneWay}" />
                <SelectorBarItem x:Name="RawTab" Text="Raw" />
                <SelectorBarItem x:Name="BodyTab" Text="Body" />
            </SelectorBar>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="HeadersPanel"
                    ItemsSource="{x:Bind Message.Headers, Mode=OneWay}"
                    ItemTemplate="{StaticResource NameValueTemplate}"
                    ItemContainerStyle="{StaticResource CompactListItemStyle}"
                    SelectionMode="None" />

                <ListView
                    x:Name="ParamsPanel"
                    Visibility="Collapsed"
                    ItemsSource="{x:Bind Message.Parameters, Mode=OneWay}"
                    ItemTemplate="{StaticResource NameValueTemplate}"
                    ItemContainerStyle="{StaticResource CompactListItemStyle}"
                    SelectionMode="None" />

                <TextBox x:Name="RawPanel" Visibility="Collapsed" Style="{StaticResource CodeBox}" Text="{x:Bind Message.RawText, Mode=OneWay}" />

                <Grid x:Name="BodyPanel" Visibility="Collapsed" RowSpacing="6" Padding="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            ItemsSource="{x:Bind vm:MessageViewModel.BodyModes}"
                            SelectedIndex="{x:Bind Message.BodyModeIndex, Mode=TwoWay}"
                            MinWidth="110" />
                        <TextBlock
                            Text="{x:Bind Message.BodySummary, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource CodeBox}"
                        Text="{x:Bind Message.BodyText, Mode=OneWay}"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(Message.IsPlainTextBody), Mode=OneWay}" />

                    <!-- JSON, XML and HTML in colour (filled in code-behind; plain text above is the fallback). -->
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource TextControlBackground}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(Message.HasColoredBody), Mode=OneWay}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="11,6,11,6">
                            <RichTextBlock
                                x:Name="ColoredBody"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer
                        Grid.Row="1"
                        ZoomMode="Enabled"
                        HorizontalScrollBarVisibility="Auto"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(Message.IsImage), Mode=OneWay}">
                        <Image
                            Source="{x:Bind helpers:UiHelpers.ToImage(Message.ImageBytes), Mode=OneWay}"
                            Stretch="None"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
