<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snoop.App.Views.WebSocketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:helpers="using:Snoop.App.Helpers">

    <UserControl.Resources>
        <DataTemplate x:Key="MessageTemplate" x:DataType="vm:WebSocketMessageRow">
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind DirectionText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Direction}" Style="{StaticResource CellText}" FontWeight="Bold" Foreground="{x:Bind helpers:UiHelpers.DirectionBrush(FromClient)}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{StaticResource CellText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Kind}" Style="{StaticResource CellText}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Size}" Style="{StaticResource CellText}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Preview}" Style="{StaticResource CellText}" FontFamily="{StaticResource MonoFont}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="6" Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
            ItemTemplate="{StaticResource MessageTemplate}"
            ItemContainerStyle="{StaticResource CompactListItemStyle}"
            SelectionMode="Single"
            BorderThickness="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <TextBox Grid.Row="2" Style="{StaticResource CodeBox}" Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" PlaceholderText="Select a message to see it in full." />
    </Grid>
</UserControl>
