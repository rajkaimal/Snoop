<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snoop.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:helpers="using:Snoop.App.Helpers">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,12">
        <StackPanel Spacing="10">
            <!-- Apply / revert -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Apply" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplySettingsCommand, Mode=OneWay}" />
                <Button Content="Revert" Command="{x:Bind ViewModel.RevertSettingsCommand, Mode=OneWay}" />
                <TextBlock
                    Text="Unsaved changes"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.Settings.IsDirty), Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.Settings.ErrorText, Mode=OneWay}"
                Foreground="{x:Bind helpers:UiHelpers.MessageBrush(ViewModel.Settings.HasError), Mode=OneWay}"
                TextWrapping="Wrap"
                FontSize="12"
                Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ViewModel.Settings.HasError), Mode=OneWay}" />

            <!-- Capture -->
            <TextBlock Text="Capture" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
            <TextBox
                Header="Port (if busy, the next 10 are tried; 0 picks any free port)"
                Text="{x:Bind ViewModel.Settings.PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="200"
                HorizontalAlignment="Left" />
            <CheckBox Content="Start capturing when Snoop opens" IsChecked="{x:Bind ViewModel.Settings.CaptureOnStartup, Mode=TwoWay}" />
            <CheckBox Content="Make Snoop the Windows system proxy while capturing" IsChecked="{x:Bind ViewModel.Settings.UseSystemProxy, Mode=TwoWay}" />
            <CheckBox Content="Also capture localhost traffic through the system proxy" IsChecked="{x:Bind ViewModel.Settings.CaptureLoopback, Mode=TwoWay}" />
            <CheckBox Content="Allow other devices (phones, other PCs) to use Snoop as their proxy" IsChecked="{x:Bind ViewModel.Settings.AllowRemote, Mode=TwoWay}" />
            <CheckBox IsChecked="{x:Bind ViewModel.Settings.AvoidZstd, Mode=TwoWay}">
                <TextBlock TextWrapping="Wrap" Text="Ask servers not to use zstd compression (removes zstd from Accept-Encoding so Snoop can show response bodies)" />
            </CheckBox>

            <!-- HTTPS -->
            <TextBlock Text="HTTPS" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
            <CheckBox Content="Decrypt HTTPS" IsChecked="{x:Bind ViewModel.Settings.DecryptHttps, Mode=TwoWay}" />
            <CheckBox IsChecked="{x:Bind ViewModel.Settings.UseBuiltInSkips, Mode=TwoWay}">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Never decrypt apps known to reject Snoop's certificate:" />
                    <Run Text="{x:Bind vm:SettingsViewModel.BuiltInSkipsText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </CheckBox>
            <CheckBox Content="Stop decrypting a host after its app rejects the certificate twice" IsChecked="{x:Bind ViewModel.Settings.AutoSkip, Mode=TwoWay}" />
            <TextBox
                Header="Never decrypt these hosts (one per line; *.example.com allowed)"
                Style="{StaticResource CodeEditor}"
                Text="{x:Bind ViewModel.Settings.SkipHostsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="110" />

            <!-- Certificate -->
            <TextBlock Text="Root certificate" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Trust" Command="{x:Bind ViewModel.TrustRootCommand, Mode=OneWay}" ToolTipService.ToolTip="Add it to your trusted roots (Windows asks you to confirm)" />
                <Button Content="Remove from Windows" Command="{x:Bind ViewModel.UntrustRootCommand, Mode=OneWay}" />
                <Button Content="Save .cer file..." Command="{x:Bind ViewModel.ExportRootCommand, Mode=OneWay}" ToolTipService.ToolTip="For phones and other PCs" />
            </StackPanel>

            <!-- Grid -->
            <TextBlock Text="Session list" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
            <TextBlock
                Text="Click a column header to sort (again to reverse, a third time for arrival order). Drag a header's edge to resize it; right-click the header to show or hide columns."
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Reset columns" Command="{x:Bind ViewModel.ResetColumnsCommand, Mode=OneWay}" />

            <TextBlock Text="Data folder" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
            <TextBlock Text="{x:Bind vm:SettingsViewModel.DataFolder}" FontFamily="{StaticResource MonoFont}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
