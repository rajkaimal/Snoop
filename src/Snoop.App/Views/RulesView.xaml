<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snoop.App.Views.RulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snoop.Presentation.ViewModels"
    xmlns:helpers="using:Snoop.App.Helpers">

    <UserControl.Resources>
        <!-- One action of a rule. What the two boxes mean depends on the action kind. -->
        <DataTemplate x:Key="ActionTemplate" x:DataType="vm:RuleActionViewModel">
            <Border
                Padding="8"
                Margin="0,0,0,6"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            ItemsSource="{x:Bind vm:RuleActionViewModel.KindNames}"
                            SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Remove" Command="{x:Bind RemoveCommand}" />
                    </Grid>

                    <TextBox
                        Header="{x:Bind NameLabel, Mode=OneWay}"
                        Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="{StaticResource MonoFont}"
                        IsSpellCheckEnabled="False"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(ShowName), Mode=OneWay}" />

                    <Grid ColumnSpacing="8" Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(IsSingleLineValue), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="{x:Bind ValueLabel, Mode=OneWay}"
                            Text="{x:Bind SingleLineValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontFamily="{StaticResource MonoFont}"
                            IsSpellCheckEnabled="False" />
                        <Button
                            Grid.Column="1"
                            Content="Browse..."
                            VerticalAlignment="Bottom"
                            Command="{x:Bind BrowseCommand}"
                            Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(CanBrowse), Mode=OneWay}" />
                    </Grid>

                    <TextBox
                        Header="{x:Bind ValueLabel, Mode=OneWay}"
                        Style="{StaticResource CodeEditor}"
                        Text="{x:Bind MultilineValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Height="140"
                        Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(IsMultilineValue), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The editor for the selected rule. -->
        <DataTemplate x:Key="RuleEditorTemplate" x:DataType="vm:RuleEditorViewModel">
            <StackPanel Spacing="8" Padding="0,0,12,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Name" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Content="On" IsChecked="{x:Bind Enabled, Mode=TwoWay}" VerticalAlignment="Bottom" MinWidth="0" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Header="When"
                        ItemsSource="{x:Bind vm:RuleEditorViewModel.MatchKindNames}"
                        SelectedIndex="{x:Bind MatchKindIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                    <TextBox
                        Grid.Column="1"
                        Header="Method"
                        PlaceholderText="Any"
                        Text="{x:Bind Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBox
                    Header="URL pattern"
                    PlaceholderText="e.g. api.example.com/v1/users"
                    Text="{x:Bind Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontFamily="{StaticResource MonoFont}"
                    IsSpellCheckEnabled="False" />

                <TextBlock
                    Text="{x:Bind ErrorText, Mode=OneWay}"
                    Foreground="{x:Bind helpers:UiHelpers.MessageBrush(HasError), Mode=OneWay}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Visibility="{x:Bind helpers:UiHelpers.VisibleWhen(HasError), Mode=OneWay}" />

                <TextBlock Text="Then (actions run in order)" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{x:Bind Actions}" ItemTemplate="{StaticResource ActionTemplate}" />
                <Button Content="Add action" Command="{x:Bind AddActionCommand}" />
            </StackPanel>
        </DataTemplate>

        <!-- A row in the rule list. -->
        <DataTemplate x:Key="RuleRowTemplate" x:DataType="vm:RuleEditorViewModel">
            <Grid ColumnSpacing="8" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind Summary, Mode=OneWay}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{x:Bind helpers:UiHelpers.MessageBrush(HasError), Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="6" Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="90" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="New rule" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddCommand, Mode=OneWay}" />
            <Button Content="Duplicate" Command="{x:Bind ViewModel.DuplicateCommand, Mode=OneWay}" />
            <Button Content="Delete" Command="{x:Bind ViewModel.RemoveCommand, Mode=OneWay}" />
            <Button Content="Up" Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneWay}" ToolTipService.ToolTip="Rules run top to bottom" />
            <Button Content="Down" Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneWay}" ToolTipService.ToolTip="Rules run top to bottom" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="Rules run top to bottom on matching requests and apply as you type. Tip: right-click a session → Auto-respond."
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
            ItemTemplate="{StaticResource RuleRowTemplate}"
            ItemContainerStyle="{StaticResource CompactListItemStyle}"
            SelectionMode="Single"
            BorderThickness="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,6,0,0">
            <ContentControl
                Content="{x:Bind ViewModel.Selected, Mode=OneWay}"
                ContentTemplate="{StaticResource RuleEditorTemplate}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                HorizontalAlignment="Stretch"
                IsTabStop="False" />
        </ScrollViewer>
    </Grid>
</UserControl>
